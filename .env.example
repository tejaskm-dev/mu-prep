# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon"/"publishable" key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role"/"secret" key — SERVER ONLY. Used for student submissions,
# requests/reports, search analytics and team management.
SUPABASE_SERVICE_ROLE_KEY=

# ── UploadThing (Dashboard → API Keys → copy the UPLOADTHING_TOKEN) ──────────
UPLOADTHING_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL, used for links in metadata and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: salt for hashing visitor IPs used in rate limiting (any random string)
IP_HASH_SALT=
